# Pluggy credentials from https://dashboard.pluggy.ai (Applications -> your app)
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=

# Comma-separated item IDs (one per MeuPluggy connection). Required: Pluggy has no endpoint that lists
# an application's items (Dashboard -> Applications -> app -> Demo -> Connected Items -> copy itemId).
PLUGGY_ITEM_IDS=

# Your CPF (digits only) and name, used to detect transfers between your own accounts.
MY_CPF=
MY_NAME=

# Binance read-only API key (API Management -> Create API -> System generated).
# Enable ONLY "Enable Reading" and restrict it to your IP. Sync refuses keys with any write permission.
BINANCE_API_KEY=
BINANCE_API_SECRET=
